{
  "name": "2warden",
  "version": "0.1.0",
  "description": "Bitwarden Secrets Manager for coding agents. The agent finds, uses and saves secrets by reference and never sees the values.",
  "keywords": [
    "bitwarden",
    "secrets-manager",
    "bws",
    "secrets",
    "ai-agents",
    "claude-code",
    "dotenv",
    "cli"
  ],
  "homepage": "https://github.com/dopiotrek/2warden#readme",
  "bugs": {
    "url": "https://github.com/dopiotrek/2warden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopiotrek/2warden.git"
  },
  "license": "MIT",
  "author": "Piotrek (https://github.com/dopiotrek)",
  "type": "module",
  "bin": {
    "2warden": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:fast": "pnpm format:check && pnpm check && pnpm lint --max-warnings 0",
    "test": "pnpm build && node --test test/*.test.mjs",
    "verify": "pnpm check:fast && pnpm test",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
